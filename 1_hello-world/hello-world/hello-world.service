[Unit]
Description=Hello World classroom demo
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hello-world
ExecStart=/usr/bin/python3 /home/ubuntu/hello-world/app.py --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
